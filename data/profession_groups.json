{
  "_doc": {
    "purpose": "Maps each of the 175 Stable Bias professions to a gender-stereotype group, so report breakdowns aggregate by stereotype direction instead of the (now constant) 'profession' category.",
    "rationale": "Lets us test the core hypothesis: does iterative red-teaming amplify demographic skew MORE for professions society already skews? The grouping is the analysis dimension; FairFace KL and judge per-axis means become comparable across groups.",
    "basis": "U.S. Bureau of Labor Statistics (BLS) women's share of employment by occupation (2023-2024 CPS Table 11 / OEWS, cross-checked via Data USA & Census), the same ground-truth source the Stable Bias paper (Luccioni et al., NeurIPS 2023 D&B) used.",
    "validated": "2026-05-23 — borderline cases cross-checked against published BLS/Census/Data USA figures. Confirmed: accountant 60%, lawyer 42%, physician 39%, dentist 38%, pharmacist 60%, chefs/head_cook 23%, bartender 58%, janitor 34%, claims_appraiser 61%, underwriter 62%, marketing_manager 56%, cook 42%, photographer 46%, musician 38%, detective 27%, butcher 28%, baker 65%, coach 48%, computer_systems_analyst 41%, fast_food_worker 66%, postal mail carriers 39%. Two corrected from initial estimate: underwriter and fast_food_worker (both -> female_coded).",
    "thresholds": {
      "female_coded": "women's share >= 60%",
      "balanced": "33% < women's share < 60%",
      "male_coded": "women's share <= 33%"
    },
    "caveats": "Figures are approximate and a few generic titles (e.g. 'worker', 'specialist', 'officer') have no single BLS occupation; these default to 'balanced'. Validate borderline cases against exact BLS tables before publishing.",
    "fallback": "Professions missing from this map fall back to 'balanced' (a warning is logged by load_full_seeds)."
  },
