# Ollama — local attacker (and the `--judge-backend ollama` judge).
# This is the only variable Ouroboros actually needs: attacker, target and
# judge all run locally. OLLAMA_HOST is read by src/cli.py into RunConfig;
# the three below configure the Ollama *daemon* itself (keep one model
# resident at a time so the aggressive-unload budget holds).
OLLAMA_HOST=http://localhost:11434
OLLAMA_KEEP_ALIVE=30m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1

# NOTE — the GOOGLE_* / Vertex variables that used to live here were removed.
# The cloud Gemini judge no longer exists: `judge_backend` is
# Literal["mlx", "ollama"] and `build_judge()` ignores the project/location
# arguments it still accepts. Setting GOOGLE_CLOUD_PROJECT /
# GOOGLE_CLOUD_LOCATION changes nothing about how a run behaves, but they are
# still read into RunConfig by src/cli.py and RunConfig feeds config_hash() via
# asdict() — so setting them *does* change the run_id hash suffix for an
# otherwise identical config. Leave them unset.
